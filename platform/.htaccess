# WKC Voting System — Apache / cPanel rules
Options -Indexes
DirectoryIndex index.php

<IfModule mod_rewrite.c>
  RewriteEngine On
  # Real files in assets/ and uploads/ are served directly; everything else goes to index.php.
  RewriteCond %{REQUEST_URI} !/(assets|uploads)/
  RewriteRule ^ index.php [L,QSA]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteRule ^ index.php [L,QSA]
</IfModule>

# Never serve config, SQL, source, tools or storage directly.
<FilesMatch "^(config\.php|config\.sample\.php|router\.php|.*\.sql|.*\.md|.*\.bat)$">
  Require all denied
</FilesMatch>

<IfModule mod_headers.c>
  <FilesMatch "\.(css|js)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>
